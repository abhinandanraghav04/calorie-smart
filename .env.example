# Core application configuration
DATABASE_URL="postgresql://user:password@localhost:5432/calorie_smart_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# Demo User Credentials (for seeding)
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD="password123"

# USDA FoodData Central API (optional - for food search integration)
# Get a free API key at: https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=""

# Deployment notes:
# - For staging/production, set NEXTAUTH_URL to your deployed domain (e.g. https://calorie-smart-staging.vercel.app)
# - DATABASE_URL should point to your managed Postgres instance (Supabase recommended)
